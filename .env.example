DATABASE_URL=sqlite:///./guia.db
API_KEY=troque-esta-chave          # protege POST /ingest/*
GOOGLE_PLACES_API_KEY=
EVENTBRITE_TOKEN=
TICKETMASTER_API_KEY=       # opcional: eventos de shows (developer.ticketmaster.com)

# ---- Segurança (veja docs/seguranca/) ----
TURIZ_ENV=dev                      # em produção: production (docs fechados, HSTS, chaves fortes obrigatórias)
# API_KEY= (legado, escopo admin) ou várias chaves com escopo, cada uma com 32+ caracteres:
TURIZ_API_KEYS=                    # nome:escopo:chave,...  escopos: ingest | moderacao | admin
TURIZ_HMAC_KEY=                    # obrigatória em produção (pseudonimiza IPs e deriva CSRF). Gere: python -c "import secrets;print(secrets.token_hex(32))"
TURIZ_ENC_KEY=                     # obrigatória em produção (cifra segredos TOTP). Gere: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TURIZ_ALLOWED_HOSTS=               # ex.: api.turiz.app (bloqueia Host forjado)
TURIZ_CORS_ORIGINS=                # só se o front ficar em outra origem; padrão: nenhuma
TURIZ_PROXY_HOPS=0                 # nº de proxies confiáveis na frente (CDN/WAF). 0 = ignora X-Forwarded-For
TURIZ_CSP_PAGINA=                  # conteúdo de dist/turiz.html.csp.txt (+ "; frame-ancestors 'none'")
TURIZ_EMAIL_BACKEND=desligado      # desligado | smtp  (smtp: TURIZ_SMTP_HOST/PORTA/USUARIO/SENHA/DE)
TURIZ_DOCS=0                       # 1 liga /docs (nunca em produção)
BACKUP_PASSPHRASE=                 # (GitHub Secret) senha do backup criptografado

